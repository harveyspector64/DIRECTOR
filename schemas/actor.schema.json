{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "recent_director_edges", "adjacency_top"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "recent_director_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["director_id", "director_name", "film_title", "year"],
        "properties": {
          "director_id": { "type": "string" },
          "director_name": { "type": "string" },
          "film_title": { "type": "string" },
          "year": { "type": "integer" }
        }
      }
    },
    "adjacency_top": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["director_id", "weight"],
        "properties": {
          "director_id": { "type": "string" },
          "weight": { "type": "number" }
        }
      }
    }
  }
}
