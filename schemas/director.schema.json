{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "aliases",
    "recent_features",
    "lane_fingerprint",
    "assignment_score",
    "scale_proxy",
    "cast_adjacency_top",
    "availability",
    "current_events",
    "data_freshness"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "countries": { "type": "array", "items": { "type": "string" } },
    "last_feature_directed_year": { "type": "integer" },
    "last_feature_released_year": { "type": "integer" },
    "recent_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "year", "genres_normalized", "top_cast"],
        "properties": {
          "title": { "type": "string" },
          "year": { "type": "integer" },
          "film_id": { "type": "string" },
          "genres_normalized": { "type": "array", "items": { "type": "string" } },
          "top_cast": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "lane_fingerprint": {
      "type": "object",
      "properties": {
        "action": { "type": "number" },
        "thriller": { "type": "number" },
        "crime": { "type": "number" },
        "comedy": { "type": "number" },
        "horror": { "type": "number" },
        "scifi": { "type": "number" },
        "drama": { "type": "number" },
        "romance": { "type": "number" },
        "family": { "type": "number" },
        "animation": { "type": "number" }
      }
    },
    "assignment_score": { "type": "number" },
    "scale_proxy": { "type": "string", "enum": ["small", "mid", "large"] },
    "cast_adjacency_top": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor_id", "actor_name", "weight"],
        "properties": {
          "actor_id": { "type": "string" },
          "actor_name": { "type": "string" },
          "weight": { "type": "number" },
          "last_worked_year": { "type": "integer" }
        }
      }
    },
    "availability": {
      "type": "object",
      "required": ["status", "confidence", "last_verified"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["HARD_BUSY", "SOFT_BUSY", "IN_POST", "LIKELY_OPEN", "UNKNOWN"]
        },
        "next_likely_open_window": {
          "type": ["object", "null"],
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "confidence": { "type": "string", "enum": ["low", "med", "high"] },
        "last_verified": { "type": "string" }
      }
    },
    "current_events": { "type": "array", "items": { "type": "string" } },
    "data_freshness": {
      "type": "object",
      "required": ["last_profile_rebuild"],
      "properties": {
        "last_event_seen": { "type": "string" },
        "last_profile_rebuild": { "type": "string" }
      }
    }
  }
}
