{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "title", "year", "director_id", "genres_raw", "genres_normalized", "top_cast"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "year": { "type": "integer" },
    "director_id": { "type": "string" },
    "genres_raw": { "type": "array", "items": { "type": "string" } },
    "genres_normalized": { "type": "array", "items": { "type": "string" } },
    "top_cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "order": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
